<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>SteampunkBombDiffusal</RootNamespace>
  </PropertyGroup>
    <!-- added by the 2dog tool: properties 2dog hosts need that were not already set -->
    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants>$(DefineConstants);LIBGODOT_ENABLED</DefineConstants>
        <DefaultItemExcludes>$(DefaultItemExcludes);Steampunk Bomb Diffusal.2dog/**;Steampunk Bomb Diffusal.web/**;Steampunk Bomb Diffusal.tests/**</DefaultItemExcludes>
    </PropertyGroup>
    <!-- added by the 2dog tool: compiles the web bootstrap (in the web host folder) into this game assembly -->
    <ItemGroup>
        <Compile Include="Steampunk Bomb Diffusal.web/TwoDogWebBoot.cs" Condition="Exists('$(MSBuildThisFileDirectory)Steampunk Bomb Diffusal.web/TwoDogWebBoot.cs')" />
    </ItemGroup>
</Project>